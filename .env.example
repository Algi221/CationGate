# Database & Auth
DATABASE_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres
JWT_SECRET=your_jwt_secret_key_here

# Frontend & Backend Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BACKEND_URL=/api

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dev Mock Token
MOCK_JWT_TOKEN=mock_jwt_token_dev

# Gatekeeper Admin Credentials
GATEKEEPER_USERNAME=uno
GATEKEEPER_PASSWORD=your_gatekeeper_password

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Midtrans Payment Gateway
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_SERVER_KEY=your_midtrans_server_key

# Google Gemini AI (CatBot Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
