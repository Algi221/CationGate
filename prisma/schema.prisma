model MutasiHistory {
  id               Int      @id @default(autoincrement())
  siswa_aktif_id   Int
  jurusan_asal     String   @db.VarChar(50)
  jurusan_tujuan   String   @db.VarChar(50)
  tanggal_mutasi   DateTime @default(now())
  dilakukan_oleh   String?  @db.VarChar(100)

  @@map("mutasi_history")
}

model Informasi {
  id         Int      @id @default(autoincrement())
  judul      String   @db.VarChar(255)
  konten     String   @db.Text
  tanggal    DateTime @db.Date
  foto_url   String?  @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@map("informasi")
}

model LandingPageConfig {
  config_key String   @id @db.VarChar(50)
  config_value Json
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  @@map("landing_page_config")
}

model UIRevision {
  id            Int      @id @default(autoincrement())
  config_values Json
  changed_by    String?  @default("admin") @db.VarChar(100)
  description   String?  @db.Text
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@map("ui_revisions")
}
